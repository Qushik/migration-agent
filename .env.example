# Migration Agent — Environment Variables
# Copy this file to .env and fill in your keys

# ─── LLM Providers ───────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Optional: Anthropic Claude as fallback
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Search & Retrieval ──────────────────────────────────
# SerpAPI for live web search (policy monitoring)
SERPAPI_KEY=your-serpapi-key-here

# Pinecone for vector memory (optional)
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX=migration-policies

# ─── Database ─────────────────────────────────────────────
# Postgres for audit trail and policy cache
DATABASE_URL=postgresql://user:pass@localhost:5432/migration_agent

# ─── Server ───────────────────────────────────────────────
PORT=3001
WEB_PORT=3000
NODE_ENV=development

# ─── Security ─────────────────────────────────────────────
API_SECRET=your-api-secret-for-rate-limiting
CORS_ORIGIN=http://localhost:3000
